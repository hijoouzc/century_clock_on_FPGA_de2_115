        <mxCell id="u_clk_div" value="&lt;b&gt;clk_div&lt;/b&gt;&lt;br/&gt;&lt;hr style=&quot;border:0.5px solid #000; margin:4px 0;&quot;/&gt;&lt;font size=&quot;9&quot;&gt;&lt;b&gt;50 MHz Prescaler&lt;/b&gt;&lt;br/&gt;• 1s Tick Generator&lt;br/&gt;• 2Hz Blink Generator&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="190" y="80" width="170" height="130" as="geometry" />
        </mxCell>
        <mxCell id="u_btn" value="&lt;b&gt;button_filter (x3)&lt;/b&gt;&lt;br/&gt;&lt;hr style=&quot;border:0.5px solid #000; margin:4px 0;&quot;/&gt;&lt;font size=&quot;9&quot;&gt;&lt;b&gt;Debounce &amp;amp; Pulse&lt;/b&gt;&lt;br/&gt;• Invert Active-Low&lt;br/&gt;• 2-Stage D-FF Sync&lt;br/&gt;• 20ms Glitch Filter&lt;br/&gt;• 1-Cycle Pulse Detect&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="190" y="310" width="170" height="160" as="geometry" />
        </mxCell>
        <mxCell id="u_core" value="&lt;b&gt;clock_core&lt;/b&gt;&lt;br/&gt;&lt;hr style=&quot;border:0.5px solid #000; margin:4px 0;&quot;/&gt;&lt;font size=&quot;9&quot;&gt;&lt;b&gt;[ FSM Controller ]&lt;/b&gt;&lt;br/&gt;S_RUN | S_SET_HOUR | S_SET_MIN&lt;br/&gt;S_SET_SEC | S_SET_DAY | S_SET_MONTH | S_SET_YEAR&lt;br/&gt;&lt;br/&gt;&lt;b&gt;[ Synchronous RTC Counters ]&lt;/b&gt;&lt;br/&gt;• sec [5:0] (0..59)   • day [4:0] (1..max_day)&lt;br/&gt;• min [5:0] (0..59)   • month [3:0] (1..12)&lt;br/&gt;• hour [4:0] (0..23)  • year [13:0] (0..9999)&lt;br/&gt;&lt;br/&gt;&lt;b&gt;[ Century Calendar Logic ]&lt;/b&gt;&lt;br/&gt;• Leap Year: ((Y%4==0 &amp;amp;&amp;amp; Y%100!=0) || Y%400==0)&lt;br/&gt;• Dynamic max_day: 28 / 29 / 30 / 31&lt;br/&gt;• Auto-Clamp Day: day &amp;lt;= max_day&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="460" y="80" width="240" height="580" as="geometry" />
        </mxCell>
        <mxCell id="u_disp" value="&lt;b&gt;display_controller&lt;/b&gt;&lt;br/&gt;&lt;hr style=&quot;border:0.5px solid #000; margin:4px 0;&quot;/&gt;&lt;font size=&quot;9&quot;&gt;&lt;b&gt;[ BCD Decomposition ]&lt;/b&gt;&lt;br/&gt;Tens = Value / 10 | Ones = Value % 10&lt;br/&gt;&lt;br/&gt;&lt;b&gt;[ Display Multiplexer ]&lt;/b&gt;&lt;br/&gt;• SW[1]=0: Time Mode (HH:MM:SS:--)&amp;nbsp;&lt;br/&gt;• SW[1]=1: Date Mode (DD:MM:YYYY)&lt;br/&gt;&lt;br/&gt;&lt;b&gt;[ Blinking / Blanking Logic ]&lt;/b&gt;&lt;br/&gt;• If SET Mode (SW[0]=1) &amp;amp; !blink:&lt;br/&gt;  Mask active field with 4&amp;apos;hF (Blank/OFF)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="800" y="80" width="230" height="580" as="geometry" />
        </mxCell>
        <mxCell id="u_dec" value="&lt;b&gt;seg7_decoder (x8)&lt;/b&gt;&lt;br/&gt;&lt;hr style=&quot;border:0.5px solid #000; margin:4px 0;&quot;/&gt;&lt;font size=&quot;9&quot;&gt;&lt;b&gt;u_hex7 .. u_hex0&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;4-bit BCD to 7-Segment&lt;br/&gt;Active-Low Truth Table&lt;br/&gt;(0: Segment ON, 1: OFF)&lt;br/&gt;&lt;br/&gt;4&amp;apos;hF: All Segments OFF&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
